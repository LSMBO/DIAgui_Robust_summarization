output_name <- "ADR"
print(getwd())
load_file <- function() {
file_path <- choose.files()
if (length(file_path) == 0) {
return(NULL)
}
extension <- file_ext(file_path)
if (extension == 'csv') {
lines <- readLines(file_path)
if (any(grepl(';', lines))) {
return(read_delim(file_path, delim = ';', col_names = TRUE))
} else {
return(read_delim(file_path, delim = '\t', col_names = TRUE))
}
} else if (extension == 'xlsx') {
return(read_excel(file_path))
}
}
write_anova <- function(results, column_names_dict) {
output_aov <- file(paste("res_", output_name, "_aov.csv", sep=''), "w")
cat("Protein",
"Df",
"Sum Sq",
"Mean Sq",
"F value",
"Pr(>F)",
"Residuals",
"Residuals Df",
"Residuals Sum Sq",
file = output_aov,
sep = "\t")
cat("\n", file = output_aov)
for (i in seq_along(results)) {
result <- results[[i]]
protein_name <- column_names_dict[[i+1]]
cat(protein_name, file = output_aov, sep='\t')
cat("\t", file = output_aov)
cat(result[-1], file = output_aov, sep='\t')
cat("\n", file = output_aov)
}
close(output_aov)
}
write_tukey <- function(results, column_names_dict) {
output_tk<-file(paste("res_", output_name, "_tk.csv", sep=''), "a")
for (i in seq_along(results)) {
tk1 <- results[[i]]
cat(sprintf("Protein %s", column_names_dict[[i+1]]), file = output_tk, sep = "\t")
cat("\n", file = output_tk)
cat("Groupe",
"Difference",
"Lwr",
"Upr",
"p adj",
file = output_tk,
sep = "\t")
cat("\n", file = output_tk)
tk_df <- as.data.frame(tk1$Groupe)
write.table(tk_df,
file = output_tk,
sep = "\t",
row.names = TRUE,
col.names = FALSE,
append = TRUE)
cat("\n", file = output_tk)
}
close(output_tk)
}
write_dunnett <- function(results, column_names_dict) {
output_dn<-file(paste("res_", output_name, "_dn.csv", sep=''),"a")
for (i in seq_along(results)) {
dunnett <- results[[i]]
cat(sprintf("Protein %s", column_names_dict[[i+1]]), file = output_dn, sep = "\t")
cat("\n", file = output_dn)
cat("Difference",
"Lwr.ci",
"Upr.Ci",
"pval",
"Comparison",
file = output_dn,
sep = "\t")
cat("\n", file = output_dn)
for (group_name in names(dunnett)) {
dunnett_result <- as.data.frame(dunnett[[group_name]])
dunnett_result$Comparison <- rownames(dunnett_result)
write.table(dunnett_result,
file = output_dn,
sep = "\t",
col.names = FALSE,
row.names = FALSE,
append = TRUE)
}
}
close(output_dn)
}
