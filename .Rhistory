cat("\n", file = output_aov)
for (i in seq_along(results)) {
result <- results[[i]]
protein_name <- column_names_dict[[i+1]]
cat(protein_name, file = output_aov, sep='\t')
cat("\t", file = output_aov)
cat(result[-1], file = output_aov, sep='\t')
cat("\n", file = output_aov)
}
close(output_aov)
}
write_tukey <- function(results, column_names_dict) {
output_tk<-file(paste("res_", output_name, "_tk.csv", sep=''), "a")
for (i in seq_along(results)) {
tk1 <- results[[i]]
cat(sprintf("Protein %s", column_names_dict[[i+1]]), file = output_tk, sep = "\t")
cat("\n", file = output_tk)
cat("Groupe",
"Difference",
"Lwr",
"Upr",
"p adj",
file = output_tk,
sep = "\t")
cat("\n", file = output_tk)
tk_df <- as.data.frame(tk1$Groupe)
write.table(tk_df,
file = output_tk,
sep = "\t",
row.names = TRUE,
col.names = FALSE,
append = TRUE)
cat("\n", file = output_tk)
}
close(output_tk)
}
write_dunnett <- function(results, column_names_dict) {
output_dn<-file(paste("res_", output_name, "_dn.csv", sep=''),"a")
for (i in seq_along(results)) {
dunnett <- results[[i]]
cat(sprintf("Protein %s", column_names_dict[[i+1]]), file = output_dn, sep = "\t")
cat("\n", file = output_dn)
cat("Difference",
"Lwr.ci",
"Upr.Ci",
"pval",
"Comparison",
file = output_dn,
sep = "\t")
cat("\n", file = output_dn)
for (group_name in names(dunnett)) {
dunnett_result <- as.data.frame(dunnett[[group_name]])
dunnett_result$Comparison <- rownames(dunnett_result)
write.table(dunnett_result,
file = output_dn,
sep = "\t",
col.names = FALSE,
row.names = FALSE,
append = TRUE)
}
}
close(output_dn)
}
tt <- tktoplevel(borderwidth = 5)
tkwm.title(tt, "Select Statistical Test")
tkgrid(tklabel(tt, text = "Select the test to perform:"),
column = 1,
row = 1,
sticky = "N,E,W")
tl1 <- tklistbox(tt,
height = 2,
selectmode = "single",
background = "white",
exportselection = 0)
tkgrid(tl1,
column = 1,
row = 2,
sticky = "N,E,W")
test_options <- c("Tukey", "Dunnett")
for (option in test_options) {
tkinsert(tl1, "end", option)
}
tkinsert(tl1, 0)
run_button <- tkbutton(tt, text = "Run Test", command = function () {
selected_index <- tkcurselection(tl1)
selected_index <- as.numeric(selected_index)
selected_test <- as.character(tkget(tl1, selected_index))
print(selected_test)
dataset <- load_file()
if (is.null(dataset)) {
tkmessageBox(title = "Error", message = "No data loaded.")
return()
}
taille<-dim(dataset)
Groupe <- as.factor(dataset[[1]])
variable <- as.numeric(dataset[[2]])
anova_results <- list()
tukey_results <- list()
dunnett_results <- list()
column_names_dict <- list()
# ANOVA
for (i in 2:taille[2]) {
column_name <- colnames(dataset)[i]
column_names_dict[[i]] <- column_name
variable<-as.numeric(dataset[[i]])
res.aov<-aov(variable~Groupe)
res.anova<-anova(res.aov)
anova_results[[i - 1]] <- c(i - 1,
res.anova[1, 1],
res.anova[1, 2],
res.anova[1, 3],
res.anova[1, 4],
res.anova[1, 5],
res.anova[2, 1],
res.anova[2, 2],
res.anova[2, 3])
if (selected_test == "Tukey") {
tk1 <- TukeyHSD(res.aov, conf.level = 0.95)
tukey_results[[i - 1]] <- tk1
}
if (selected_test == "Dunnett") {
control <- "0all"
dunnett <- DunnettTest(x=variable, g=Groupe, control=control)
dunnett_results[[i - 1]] <- dunnett
}
}
write_anova(anova_results, column_names_dict)
if (selected_test == "Tukey") {
write_tukey(tukey_results, column_names_dict)
}
if (selected_test == "Dunnett") {
write_dunnett(dunnett_results, column_names_dict)
}
tkdestroy(tt)
tkmessageBox(title = "Success", message = "Tests completed!")
})
tkgrid(run_button, column = 1, row = 3, sticky = "N,E,W")
